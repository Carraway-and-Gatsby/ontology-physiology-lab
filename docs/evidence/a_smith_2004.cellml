    <rdf:Description rdf:about="#flow.Q_pul">
      <semsim:isComputationalComponentFor>
        <rdf:Description rdf:about="#property_15">
          <semsim:physicalPropertyOf>
            <rdf:Description rdf:about="#process_2">
              <semsim:hasSinkParticipant>
                <rdf:Description rdf:about="#sink_2" semsim:hasMultiplier="1.0">
                  <semsim:hasPhysicalEntityReference>
                    <rdf:Description rdf:about="#entity_8">
                      <ro:part_of>
                        <rdf:Description rdf:about="#entity_9">
                          <semsim:hasPhysicalDefinition rdf:resource="http://purl.obolibrary.org/obo/FMA_52455" />
                        </rdf:Description>
                      </ro:part_of>
                      <semsim:hasPhysicalDefinition rdf:resource="http://purl.obolibrary.org/obo/FMA_9670" />
                    </rdf:Description>
