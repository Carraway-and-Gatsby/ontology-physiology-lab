PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX e: <urn:smith2004:prov:>

# Source: W3C PROV-O Recommendation 2013, sections 3.1, 3.2, 3.3 and 4.
# Mapping direction: Activity used Entity; Entity wasGeneratedBy Activity;
# derived Entity wasDerivedFrom source Entity; Activity qualifiedAssociation
# Association; Association agent Agent and hadPlan Plan.
# All local predicates are metadata, not additions to the PROV vocabulary.
e:record a prov:Entity ;
    rdfs:label "Smith 2004 completed-run traceability" ;
    e:vocabularySource <https://www.w3.org/TR/2013/REC-prov-o-20130430/> ;
    e:vocabularyVersion "W3C Recommendation 2013-04-30" ;
    e:sourceLocation "prov-o.txt:458-516 (Entity, Activity, used, wasGeneratedBy, wasDerivedFrom); :5130-5140 (qualifiedAssociation); :5547-5583 (hadPlan)" ;
    e:pinnedCommit "63d3ac1a1fe04c3a22bdb19309a20dbb699abc33" ;
    e:primaryText e:prov-primary-text ;
    rdfs:comment "Traceability only; no numerical or physiological validation. Verbatim evidence, extracted facts, interpretations and unresolved conflicts use distinct local predicates. No solver or comparator was invoked to author this record." ;
    e:revisionNote "Drafted by Hermes under request [redacted: request id] (patch SHA-256 e47d5ba6dcefa3078a91c3ed6c8416db9faea2a17e65eb8b77c972c1cc9b2904). Revised in local review on 2026-11-01 before commit: (1) the 15 historical route events are e:RoutedModelEvent records instead of prov:Association, because route.model shows routing, not a completed call; (2) prov:wasAssociatedWith added beside every prov:qualifiedAssociation. File hashes, byte sizes, plans, times and the CVODE record are unchanged from the draft." .

