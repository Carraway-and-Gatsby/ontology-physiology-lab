e:plan-reference a prov:Plan, prov:Entity ;
    rdfs:label "Smith 2004 OpenCOR reference run" ;
    prov:wasDerivedFrom e:decisions ;
    e:sourceLocation "docs/decisions.md:18 at commit 63d3ac1a1fe04c3a22bdb19309a20dbb699abc33" ;
    e:approvalEvidence "user-approved (source decision entry; not an execution timestamp)" ;
    e:verbatimEvidence "Smith 2004 OpenCOR reference run (2026-11-01, user-approved): fixed-step RK4 replaces CVODE only, because the default run failed with a KINSOL iteration-limit error. KINSOL, model, parameters and units are unchanged; results are labelled RK4 and do not explain the CVODE failure." .

e:plan-comparison a prov:Plan, prov:Entity ;
    rdfs:label "Smith 2004 RK4 value comparison" ;
    prov:wasDerivedFrom e:decisions ;
    e:sourceLocation "docs/decisions.md:20 at commit 63d3ac1a1fe04c3a22bdb19309a20dbb699abc33" ;
    e:approvalEvidence "user-approved (source decision entry; not an execution timestamp)" ;
    e:verbatimEvidence "Smith 2004 RK4 value comparison (2026-11-01, user-approved): report-only, no pass/fail line. The literature read (Pathmanathan & Gray 2013 and 2014, Erdemir 2020, Santiago 2022, Mulugeta 2018) prescribes a verification procedure but no universal numeric acceptance threshold; the level is set by context of use, and this project is an exploratory prototype. Step-halving results (observed order and error per quantity of interest) are reported without being declared passed or failed. A passing result would still not establish scientific validity." .

e:plan-tolerance a prov:Plan, prov:Entity ;
    rdfs:label "Smith 2004 time-stamp tolerance" ;
    prov:wasDerivedFrom e:decisions ;
    e:sourceLocation "docs/decisions.md:21 at commit 63d3ac1a1fe04c3a22bdb19309a20dbb699abc33" ;
    e:approvalEvidence "user-approved (source decision entry; not an execution timestamp)" ;
    e:verbatimEvidence "Smith 2004 time-stamp tolerance (2026-11-01, user-approved, supersedes the 1e-9 s entry above): the 1e-9 s value was chosen by the assistant, not taken from literature. Output times count as equal when |dt| <= N_steps * eps(2.22e-16) * t_max (about 1.0e-10 s for 3.0e5 steps to 1.5 s). It rests on IEEE 754 double arithmetic, not on biomedical literature." .

e:plan-steps a prov:Plan, prov:Entity ;
    rdfs:label "Smith 2004 step sizes" ;
    prov:wasDerivedFrom e:decisions ;
    e:sourceLocation "docs/decisions.md:22 at commit 63d3ac1a1fe04c3a22bdb19309a20dbb699abc33" ;
    e:approvalEvidence "user-approved (source decision entry; not an execution timestamp)" ;
    e:verbatimEvidence "Smith 2004 step sizes (2026-11-01, user-approved): a third RK4 step size, 2.5e-6 s (run C), is added to 1e-5 s and 5e-6 s so an observed order of convergence can be computed; two sizes cannot give one." .

e:plan-scalars a prov:Plan, prov:Entity ;
    rdfs:label "Smith 2004 run C and scalar definitions" ;
    prov:wasDerivedFrom e:decisions ;
    e:sourceLocation "docs/decisions.md:23 at commit 63d3ac1a1fe04c3a22bdb19309a20dbb699abc33" ;
    e:approvalEvidence "user-approved (source decision entry; not an execution timestamp)" ;
    e:verbatimEvidence "Smith 2004 run C and scalar definitions (2026-11-01, user-approved, fixed before run C results exist): run C changes only the integration step (2.5e-6 s); the output interval stays 0.001 s as in A and B (1,501 rows each, not one row per integration step). A, B and C are compared by the same output index, with time-stamp equality checked by the derived bound above and N_steps = 1.5 / the run's integration step. Scalars: stroke volume per beat = trapezoidal integral of max(Q_av, 0) over the CSV samples; valve opening = first sample with Q_av > 0, closing = first later sample with Q_av <= 0, no interpolation; beats are 0-0.75 s and 0.75-1.5 s, with the 0.75 s sample in both. Valve times therefore have 1 ms resolution and are reported, not used as a convergence measure. The optional negative-flow integral (min(Q_av, 0)) was not adopted; negative Q_av values and their sample-time spans are only recorded. Adding it after run C results exist would no longer be fixed in advance." .

e:plan-tolerance e:supersessionEvidence "docs/decisions.md:21 explicitly supersedes :19. The old time-stamp tolerance is not an active Plan and is not applied here." .

# CVODE has no generated output Entity. The comment is the verbatim error only.
e:run-cvode a prov:Activity ; rdfs:label "Failed default CVODE plus KINSOL invocation" ;
    prov:used e:cellml, e:archive, e:launcher, e:runner-cvode ;
    prov:qualifiedAssociation e:cvode-executor ;
    prov:wasAssociatedWith e:opencor ;
    e:evidence e:cvode-command, e:cvode-result, e:cvode-readback ;
    e:wrapperSource e:wrapper-cvode ;
    e:workflowContext e:workflow-cvode ;
    e:outcome "failure" ; e:startStatus "UNKNOWN" ; e:endStatus "UNKNOWN" ;
    rdfs:comment "std::runtime_error: the maximum number of iterations was reached before convergence" ;
    e:sourceLocation "result.json:$.failure_reason (:4), $.finished_utc (:194), $.observation_limits.error_location (:206); script-report.json:$.default_solvers; command.json:$.argv[1], $.script_sha256" ;
    e:extractedFact "result.json:$.finished_utc is result completion only, not an activity end. script-report.json:$.default_solvers records CVODE and KINSOL." ;
    e:solverAttributionStatus "UNKNOWN" ;
    e:unresolvedConflict "Raw exception does not distinguish CVODE from KINSOL; initialization versus integration is unresolved at result.json:206. docs/decisions.md:18 has stronger historical KINSOL prose; that prose is not measured causal evidence." .
e:cvode-executor a prov:Association ; prov:agent e:opencor ; prov:hadRole e:numericalExecution .

# A/B/C activities deliberately include the logged invocation and settings inspection.
# Their readbacks are evidence used in that boundary, not causal configuration inputs.
# No readback is asserted to be generated by these activities (no use/generation cycle).


e:run-a a prov:Activity ; rdfs:label "RK4 run A: invocation plus settings-inspection record" ;
    e:integrationMethod "RK4" ; e:stepSeconds "1e-5"^^xsd:double ;
    prov:used e:cellml, e:archive, e:launcher, e:runner-ab, e:a-readback ;
    prov:qualifiedAssociation e:a-executor, e:a-reference-approval ;
    prov:wasAssociatedWith e:opencor, e:project-owner ;
    e:evidence e:a-command, e:a-result ;
    e:wrapperSource e:wrapper-ab ; e:workflowContext e:workflow-ab ;
    e:sourceLocation "<server path>/artifacts/smith-canonical-opencor-run/rk4-runner-fix-r1/rk4_h1e-5/command.json:$.argv[1], $.argv[3], $.script_sha256; script-report.json:$.settings_before, $.settings_after" ;
    e:verbatimEvidence "\"name\": \"Runge-Kutta (4th order)\"", "\"Step\": 1e-05" ;
    e:extractedFact "settings_before has CVODE and KINSOL; settings_after has RK4 and KINSOL. Step is in seconds. Runner path is taken from command.json argv, not the output directory name." ;
    e:interpretation "Activity boundary is the logged invocation plus settings-inspection record. prov:used on readback denotes inspection evidence, not a runtime configuration file." ;

    e:startStatus "UNKNOWN" ; e:endStatus "UNKNOWN" ;
    rdfs:comment "No start/end UTC keys occur in the case command.json, result.json or script-report.json; no file mtime or later summary time is used." .

e:a-executor a prov:Association ; prov:agent e:opencor ; prov:hadRole e:numericalExecution .

e:a-reference-approval a prov:Association ; prov:agent e:project-owner ;
    prov:hadRole e:approval ; prov:hadPlan e:plan-reference ;
    e:interpretation "Mapping the user-approved decision to this run is a traceability interpretation of the decision scope; it does not date an approval event." .

e:run-b a prov:Activity ; rdfs:label "RK4 run B: invocation plus settings-inspection record" ;
    e:integrationMethod "RK4" ; e:stepSeconds "5e-6"^^xsd:double ;
    prov:used e:cellml, e:archive, e:launcher, e:runner-ab, e:b-readback ;
    prov:qualifiedAssociation e:b-executor, e:b-reference-approval ;
    prov:wasAssociatedWith e:opencor, e:project-owner ;
    e:evidence e:b-command, e:b-result ;
    e:wrapperSource e:wrapper-ab ; e:workflowContext e:workflow-ab ;
    e:sourceLocation "<server path>/artifacts/smith-canonical-opencor-run/rk4-runner-fix-r1/rk4_h5e-6/command.json:$.argv[1], $.argv[3], $.script_sha256; script-report.json:$.settings_before, $.settings_after" ;
    e:verbatimEvidence "\"name\": \"Runge-Kutta (4th order)\"", "\"Step\": 5e-06" ;
