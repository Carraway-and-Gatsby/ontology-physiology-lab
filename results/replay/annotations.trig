<https://example.org/physiosim/graph/model-assertions> {
    <https://example.org/physiosim/variable/CO> a sim:AnnotatedVariable ;
        rdfs:label "CO" ;
        dcterms:source "docs/physiology.md" ;
        sim:anatomy <http://purl.org/sig/ont/fma/fma7101> ;
        sim:applicableScenario <https://example.org/physiosim/scenario/baseline>,
            <https://example.org/physiosim/scenario/partial_contractility_restoration>,
            <https://example.org/physiosim/scenario/reduced_contractility> ;
        sim:bearerKind "flow process" ;
        sim:dependsOn <https://example.org/physiosim/variable/HR>,
            <https://example.org/physiosim/variable/Q_aortic> ;
        sim:equation "CO = integral(Q_aortic, complete_beat)/T" ;
        sim:flowSink <https://example.org/physiosim/concept/sa> ;
        sim:flowSource <http://purl.org/sig/ont/fma/fma7101> ;
        sim:physicalProperty <https://example.org/physiosim/concept/cardiac_output> ;
        sim:processContext <http://purl.obolibrary.org/obo/GO_0008015> ;
        sim:propertyOf <https://example.org/physiosim/bearer/CO> ;
        sim:reference "not applicable" ;
        sim:role "observable" ;
        sim:sourceContext "project six-compartment lumped cardiovascular model; not a clinical measurement" ;
        sim:temporalContext "complete-beat mean" ;
        sim:unit "mL/s" .

